# ----- Required for the multi-user app (logins, shared edits, secret items) -----

# Postgres connection string. On Vercel: Storage → Marketplace → Neon/Postgres,
# which auto-sets DATABASE_URL. Locally, run `vercel env pull .env.local`, or paste
# your Neon/Supabase connection string here.
DATABASE_URL=

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ----- Optional: legacy browser-sync for the checklist (not needed) -----
# The checklist still saves locally; these only power the old cross-device
# "sync code". Safe to leave blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
