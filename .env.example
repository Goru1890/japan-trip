# Cross-device sync (OPTIONAL).
# Without these, the app runs fine and saves your checklist + start date in the
# browser (localStorage). Add them to enable syncing across devices via a code.
#
# Easiest setup: Vercel dashboard → your project → Storage → Marketplace →
# "Upstash for Redis" → Create. Vercel injects these two vars automatically.
# Or create a free database at https://upstash.com and copy the REST values here.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
